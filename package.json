{
  "name": "novel-builder",
  "version": "8.1.6",
  "description": "MD/TXT 小说目录 → Content Core → Web Publisher / EPUB / BookOrbit",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "core",
    "importer",
    "web"
  ],
  "bin": {
    "novel-builder": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "start:web": "npm run start -w web",
    "import:novel": "tsx importer/src/index.ts",
    "seed:100": "tsx scripts/seed-100.ts",
    "check:core": "tsx scripts/check-core.ts",
    "pack:deploy": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/pack-deploy.ps1",
    "once": "tsx src/index.ts --once",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w core && npm run typecheck -w web",
    "test": "tsx scripts/verify.ts",
    "test:core": "tsx scripts/verify-admin-core.ts",
    "test:api": "tsx scripts/verify-admin-api.ts",
    "test:admin-auth": "tsx scripts/verify-admin-auth.ts",
    "test:media": "tsx scripts/verify-admin-media.ts",
    "test:publish": "tsx scripts/verify-publish-workflow.ts",
    "test:publish-api": "tsx scripts/verify-publish-api.ts",
    "test:story": "tsx scripts/verify-story-core.ts",
    "test:story-context": "tsx scripts/verify-story-context.ts",
    "test:ai-writer": "tsx scripts/verify-ai-writer.ts",
    "test:ai-api": "tsx scripts/verify-ai-api.ts",
    "test:settings": "tsx scripts/verify-admin-settings.ts",
    "test:ai-serial": "tsx scripts/verify-ai-serial.ts",
    "test:ai-serial-api": "tsx scripts/verify-ai-serial-api.ts",
    "test:short-story": "tsx scripts/verify-short-story-core.ts",
    "test:short-story-publication": "tsx scripts/verify-short-story-publication.ts",
    "test:short-story-schedule": "tsx scripts/verify-short-story-schedule.ts",
    "test:short-story-reader": "tsx scripts/verify-short-story-reader.ts",
    "test:chapter-review": "tsx scripts/verify-chapter-review.ts",
    "test:chapter-review-auto-enqueue": "tsx scripts/verify-chapter-review-auto-enqueue.ts",
    "test:chapter-optimize": "tsx scripts/verify-chapter-optimize.ts",
    "test:arc-review": "tsx scripts/verify-arc-review.ts",
    "test:scheduler-tasks": "tsx scripts/verify-scheduler-tasks.ts",
    "test:scheduler-lock": "tsx scripts/verify-scheduler-lock.ts",
    "test:review-stats": "tsx scripts/verify-review-stats.ts",
    "test:tts-reader": "tsx scripts/verify-tts-reader.ts",
    "test:e2e": "playwright test",
    "test:review-rule": "tsx scripts/verify-review-rule.ts",
    "test:review-prompt": "tsx scripts/verify-review-prompt.ts",
    "test:structured-output": "tsx scripts/verify-structured-output.ts",
    "test:review-engine": "tsx scripts/verify-review-engine.ts",
    "test:auto-optimize": "tsx scripts/verify-auto-optimize.ts",
    "test:ai-assist": "tsx scripts/verify-ai-assist.ts",
    "test:creation-api": "tsx scripts/verify-creation-api.ts",
    "test:review-api": "tsx scripts/verify-review-api.ts",
    "test:reader": "tsx scripts/verify-reader.ts",
    "test:reader-api": "tsx scripts/verify-reader-api.ts",
    "test:discovery": "tsx scripts/verify-discovery.ts",
    "test:discovery-api": "tsx scripts/verify-discovery-api.ts",
    "test:analytics": "tsx scripts/verify-analytics.ts",
    "scheduler": "tsx scripts/publish-scheduler.ts",
    "doc-sync": "pnpm run verify-agent-note-classification && pnpm run verify-agent-note-format && pnpm run verify-archived-agent-notes",
    "verify-agent-note-classification": "tsx scripts/verify-agent-note-classification.ts",
    "verify-agent-note-format": "tsx scripts/verify-agent-note-format.ts",
    "verify-archived-agent-notes": "tsx scripts/verify-archived-agent-notes.ts",
    "seal-archived": "tsx scripts/verify-archived-agent-notes.ts --write"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
